pipeline{
  agent any

  stages{

    stage('Checkout'){
      steps{
        echo 'code checked out'
      }
    }

    stage('Install'){
      steps{
        sh 'npm install'
      }
    }

    stage('Test'){
      steps{
        sh 'npm test'
      }
    }

    stage('Build'){
      steps{
        echo 'Build successful'
      }
    }

  }

  post {
    success{
      echo 'Pipeline Success'
    }
  }


}